class Solution {
    public boolean halvesAreAlike(String s) {
        String vowels = "aeiouAEIOU";
        int leftCount = 0;
        int rightCount = 0;
        
        int i = 0;
        int j = s.length() - 1;
        
        while (i < j) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                leftCount++;
            }
            if (vowels.indexOf(s.charAt(j)) != -1) {
                rightCount++;
            }
            i++;
            j--;
        }
        
        return leftCount == rightCount;
    }
}
