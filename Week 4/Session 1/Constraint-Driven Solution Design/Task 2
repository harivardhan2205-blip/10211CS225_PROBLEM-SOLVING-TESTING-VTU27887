import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        int t = sc.nextInt();
        
        while (t-- > 0) {
            String s = sc.next();
            int n = s.length();
            
            // Frequency arrays for lowercase English letters
            int[] leftCount = new int[26];
            int[] rightCount = new int[26];
            
            // Populate left half
            for (int i = 0; i < n / 2; i++) {
                leftCount[s.charAt(i) - 'a']++;
            }
            
            // Populate right half (skip middle character if n is odd)
            int startRight = (n % 2 == 0) ? (n / 2) : (n / 2 + 1);
            for (int i = startRight; i < n; i++) {
                rightCount[s.charAt(i) - 'a']++;
            }
            
            // Compare character frequencies
            boolean isLapindrome = true;
            for (int i = 0; i < 26; i++) {
                if (leftCount[i] != rightCount[i]) {
                    isLapindrome = false;
                    break;
                }
            }
            
            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        sc.close();
	}
}
